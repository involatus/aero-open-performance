# Turns on the admin area. Use a long random password of at least 16 characters.
# Set this in your host's settings. Never commit a real one.
ADMIN_PASSWORD=

# Optional. The address pilots send Reports to. It is shown on the Send step, put in the email,
# and copied when a pilot shares a PDF. Anyone with the app can read it, so use a role address.
# Changing it needs a redeploy.
PUBLIC_REPORT_EMAIL=

# Optional. Without it, pilots enter weather by hand.
# Set this in your host's settings. Never commit a real key.
CHECKWX_API_KEY=
