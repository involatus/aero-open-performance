{
  "name": "aero-open-performance",
  "version": "0.3.0",
  "private": true,
  "description": "Open-source mass and balance and performance PWA for piston aircraft. Pre-release, not for flight.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "schema": "node --no-warnings scripts/export-schema.ts",
    "verify:reference": "node --no-warnings tools/reference-calculator/compare.ts",
    "prepare": "svelte-kit sync || true",
    "pretest": "svelte-kit sync",
    "test:e2e": "playwright test",
    "data": "node --no-warnings tools/data/cli.ts",
    "data:demo": "rm -rf static/data && node --no-warnings tools/data/cli.ts publish --source aircraft-examples --out static/data --release 1 --operator \"Demo data\" --notes \"Fictional demo aircraft with invented data.\"",
    "airports": "node --no-warnings scripts/airports.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/adapter-vercel": "7.0.3",
    "@sveltejs/kit": "3.2.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.66.0",
    "@standard-schema/spec": "1.1.0",
    "@valibot/to-json-schema": "1.8.0",
    "@vercel/blob": "2.9.0",
    "bits-ui": "2.21.0",
    "esm-env": "1.2.2",
    "geomagnetism": "0.2.0",
    "idb-keyval": "6.3.0",
    "pdfmake": "0.3.14",
    "valibot": "1.5.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
