{
  "name": "aero-open-performance",
  "version": "0.2.0",
  "private": true,
  "description": "Open-source mass and balance and performance PWA for piston aircraft. Pre-release, not for flight.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "schema": "node --no-warnings scripts/export-schema.ts",
    "verify:reference": "node --no-warnings tools/reference-calculator/compare.ts",
    "prepare": "svelte-kit sync || true",
    "pretest": "svelte-kit sync",
    "test:e2e": "playwright test",
    "data": "node --no-warnings tools/data/cli.ts",
    "data:demo": "rm -rf static/data && node --no-warnings tools/data/cli.ts publish --source aircraft-examples --out static/data --release 1 --operator \"Demo data\" --notes \"Fictional demo aircraft with invented data.\""
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@sveltejs/adapter-vercel": "7.0.2",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@sjsf/ajv8-validator": "3.9.1",
    "@sjsf/basic-theme": "3.9.1",
    "@sjsf/form": "3.9.1",
    "@standard-schema/spec": "1.1.0",
    "@valibot/to-json-schema": "1.8.0",
    "@vercel/blob": "2.8.2",
    "bits-ui": "2.20.6",
    "esm-env": "1.2.2",
    "idb-keyval": "6.3.0",
    "json-schema-merge-allof": "0.8.1",
    "json-schema-typed": "8.0.2",
    "pdfmake": "0.3.13",
    "valibot": "1.5.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
