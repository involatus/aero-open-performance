{
	"id": "/",
	"name": "Aero Open Performance",
	"short_name": "AoP",
	"lang": "en",
	"description": "Mass and balance and takeoff and landing performance for piston aircraft. Open source, and works offline.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#14263a",
	"theme_color": "#14263a",
	"icons": [
		{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
		{ "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
		{ "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
		{ "src": "icons/icon-monochrome-512.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" }
	],
	"shortcuts": [
		{
			"name": "New calculation",
			"short_name": "New",
			"description": "Start a calculation from the aircraft list",
			"url": "/?open=new",
			"icons": [
				{ "src": "icons/shortcut-new-96.png", "sizes": "96x96", "type": "image/png" },
				{ "src": "icons/shortcut-new-192.png", "sizes": "192x192", "type": "image/png" }
			]
		},
		{
			"name": "Reports",
			"description": "The reports created on this device",
			"url": "/?open=reports",
			"icons": [
				{ "src": "icons/shortcut-reports-96.png", "sizes": "96x96", "type": "image/png" },
				{ "src": "icons/shortcut-reports-192.png", "sizes": "192x192", "type": "image/png" }
			]
		}
	]
}
